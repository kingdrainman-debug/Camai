{
  "name": "camai",
  "productName": "CAMAI",
  "version": "1.0.0",
  "description": "Camcorder emulation for picture and sound: MiniDV and Digital8, the operator, a small cheap lens, an interlaced CCD that smears, the automatic camera, the DV codec with its fixed bit budget, dropouts and recording breaks, the camera display and its paths, capture, deinterlacing and the 2006 upload — and the camera’s own sound.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kingdrainman-debug/Camai.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/kingdrainman-debug/Camai",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron:dev": "CAMAI_DEV_SERVER=http://localhost:5173 electron .",
    "electron:start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:all": "npm run build && electron-builder -mwl",
    "smoke": "node scripts/smoke.mjs",
    "shots": "npm run build && node scripts/shots.mjs",
    "test": "npm run typecheck && npm run build && npm run help:check && npm run smoke",
    "help:check": "node scripts/check-help.mjs",
    "bench": "npm run build && node scripts/bench.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "pack:win": "npm run build && electron-builder --win dir --x64",
    "docs": "node scripts/docs.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.49.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "app.camai.desktop",
    "productName": "CAMAI",
    "copyright": "Copyright © 2026 CAMAI contributors",
    "extraMetadata": {
      "description": "CAMAI camcorder emulator"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "CAMAI",
      "uninstallDisplayName": "CAMAI"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}",
      "unicode": true
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb"
      ],
      "synopsis": "Camcorder emulation for picture and sound",
      "description": "Camcorder emulation for picture and sound: MiniDV and Digital8, the operator, a small cheap lens, an interlaced CCD that smears, the automatic camera, the DV codec with its fixed bit budget, dropouts and recording breaks, the camera display and its paths, capture, deinterlacing and the 2006 upload — and the camera’s own sound."
    }
  },
  "author": {
    "name": "CAMAI contributors"
  }
}
